# O Coolify gera e persiste os valores SERVICE_* ao carregar compose.yaml.
# APP_URL acompanha o domínio associado ao serviço web, porta interna 8080.
# APP_KEY usa SERVICE_REALBASE64_APPKEY (32 bytes), com prefixo base64:.
# As senhas SERVICE_PASSWORD_POSTGRES e SERVICE_PASSWORD_REDIS são compartilhadas
# pelos serviços que precisam delas. Não é necessário criar senhas manualmente.
#
# Overrides opcionais. Em instalações existentes, mantenha os valores originais:
# APP_URL=https://pedidos.seudominio.com
# APP_KEY=base64:SUA_CHAVE_EXISTENTE
# DB_PASSWORD=SUA_SENHA_EXISTENTE
# REDIS_PASSWORD=SUA_SENHA_EXISTENTE
# IP/CIDR real do proxy Coolify. Não usar * em servidor exposto diretamente.
TRUSTED_PROXIES=
